{
  "name": "mertloch-chronicles",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "homepage": "https://mertloch.esm-consultant.de/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ER-ESM/mertloch-chronicles.git"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/source-guard.mjs && node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "content:check": "node scripts/content-check.mjs && node --test tests/content*.test.mjs",
    "content:balance": "node scripts/balance-report.mjs --json",
    "balance:sheet": "node scripts/balance-sheet.mjs",
    "content:art": "node scripts/art-brief.mjs",
    "world:import": "node scripts/import-world.mjs",
    "world:build": "node scripts/build-world.mjs",
    "world:validate": "node scripts/build-world.mjs --seeds 1,42,56753,73519,2026,987654",
    "sprites:build": "node tools/sprite-pipeline/build.mjs",
    "sprites:check": "node --test tests/sprite-pipeline.test.mjs tests/maifeld-prototype.test.mjs tests/maifeld-walk.test.mjs tests/maifeld-boar-rig.test.mjs tests/live-art.test.mjs",
    "sprites:brief": "node tools/sprite-pipeline/brief.mjs",
    "sprites:detail": "node tools/sprite-pipeline/build-detail.mjs && node tools/sprite-pipeline/build-walk.mjs && node tools/sprite-pipeline/build-boar-rig.mjs",
    "sprites:walk": "node tools/sprite-pipeline/build-walk.mjs",
    "sprites:boar": "node tools/sprite-pipeline/build-boar-rig.mjs",
    "sprites:live": "node tools/sprite-pipeline/build-live.mjs",
    "sprites:precision": "node tools/sprite-pipeline/build-precision.mjs",
    "sprites:generate": "node tools/sprite-pipeline/imagegen.mjs",
    "loading:build": "node tools/loading-screens/build.mjs",
    "loading:check": "node scripts/loading-screen-check.mjs",
    "mobile:check": "node scripts/mobile-check.mjs",
    "ui:check": "node scripts/ui-regression-check.mjs",
    "meter:check": "node scripts/meter-check.mjs",
    "hud:check": "node scripts/hud-check.mjs",
    "shop:check": "node scripts/shop-check.mjs",
    "kiosk:check": "node scripts/kiosk-instance-check.mjs",
    "kit:check": "node scripts/kit-check.mjs",
    "pwa:check": "npm run build && node scripts/basis-pwa-check.mjs",
    "performance:check": "node scripts/performance-check.mjs",
    "prerender:build": "node tools/prerender/build-prerender.mjs",
    "prerender:demo": "node tools/prerender/demo-sheet.mjs",
    "prerender:shadow-check": "node tools/prerender/shadow-check.mjs",
    "redesign:build": "node tools/redesign/build.mjs",
    "redesign:check": "node --test tests/redesign.test.mjs",
    "fx:build": "node tools/skill-fx/build.mjs",
    "fx:check": "node --test tests/combat-fx.test.mjs",
    "ui:kit:build": "node tools/ui-kit/build.mjs",
    "ui:kit:check": "node --test tests/ui-kit.test.mjs",
    "ui:kit:browser": "node scripts/ui-kit-check.mjs",
    "mounts:build": "node scripts/build-mounts.mjs",
    "mounts:check": "node --test tests/mounts.test.mjs && node scripts/mount-check.mjs && node scripts/mount-art-check.mjs",
    "mounts:online-check": "node scripts/mount-online-check.mjs",
    "professions:check": "node --test tests/professions.test.mjs && node scripts/profession-check.mjs && node scripts/profession-solo-check.mjs"
  }
}
