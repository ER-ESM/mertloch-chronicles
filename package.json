{
  "name": "mertloch-chronicles",
  "version": "0.19.1",
  "private": true,
  "type": "module",
  "homepage": "https://er-esm.github.io/mertloch-chronicles/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ER-ESM/mertloch-chronicles.git"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "content:check": "node scripts/content-check.mjs && node --test tests/content.test.mjs",
    "content:balance": "node scripts/balance-report.mjs --json",
    "content:art": "node scripts/art-brief.mjs",
    "world:import": "node scripts/import-world.mjs",
    "world:build": "node scripts/build-world.mjs",
    "world:validate": "node scripts/build-world.mjs --seeds 1,42,56753,73519,2026,987654",
    "sprites:build": "node tools/sprite-pipeline/build.mjs",
    "sprites:check": "node --test tests/sprite-pipeline.test.mjs tests/maifeld-prototype.test.mjs tests/maifeld-walk.test.mjs tests/maifeld-boar-rig.test.mjs tests/live-art.test.mjs",
    "sprites:brief": "node tools/sprite-pipeline/brief.mjs",
    "sprites:detail": "node tools/sprite-pipeline/build-detail.mjs && node tools/sprite-pipeline/build-walk.mjs && node tools/sprite-pipeline/build-boar-rig.mjs",
    "sprites:walk": "node tools/sprite-pipeline/build-walk.mjs",
    "sprites:boar": "node tools/sprite-pipeline/build-boar-rig.mjs",
    "sprites:live": "node tools/sprite-pipeline/build-live.mjs"
  }
}
